generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  assets    Asset[]
}

model Asset {
  id           Int        @id @default(autoincrement())
  ticker       String
  name         String
  category     String
  ceilingPrice Float?
  currentPrice Float      @default(0)
  userId       Int
  user         User       @relation(fields: [userId], references: [id])
  dividends    Dividend[]
  purchases    Purchase[]
  sales        Sale[]
  projections  Projection[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([ticker, userId])
}

model Dividend {
  id        Int      @id @default(autoincrement())
  amount    Float
  quantity  Float?
  unitPrice Float?
  date      DateTime
  type      String   @default("DIVIDENDO")
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Projection {
  id               Int      @id @default(autoincrement())
  year             Int
  payoutPct        Float?
  dividendPerShare Float
  assetId          Int
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, year])
}

model Purchase {
  id       Int      @id @default(autoincrement())
  quantity Float
  price    Float
  date     DateTime
  assetId  Int
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Sale {
  id       Int      @id @default(autoincrement())
  quantity Float
  price    Float
  date     DateTime
  assetId  Int
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}
